# offline uses local example responses without a model. No credentials needed.
AI_PROVIDER=offline

# For OpenAI or an OpenAI-compatible service, set AI_PROVIDER=openai.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# For a local Ollama server, set AI_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2